        "\"Saint Basil's Cathedral\"", "\"Alhambra Granada\"", "\"CN Tower\"", "\"Space Needle\"", "\"Chrysler Building\"",
        "\"Flatiron Building\"", "\"Lincoln Memorial\"", "\"United States Capitol\"", "\"Christ the Redeemer\"",
        "\"Potala Palace\"", "\"Temple of Heaven\"", "\"Lotus Temple\"", "\"Golden Temple\" Amritsar",
