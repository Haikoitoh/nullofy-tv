        "Manhattan skyline", "Shenzhen", "\"Taj Mahal\"", "\"Eiffel Tower\"", "\"Petra\" Jordan", "\"Machu Picchu\"",
        "\"Great Wall\"", "\"Angkor Wat\"", "Dubai skyline", "\"Tower Bridge\"", "\"Statue of Liberty\"",
        "\"Sagrada Família\"", "Neuschwanstein", "\"Mont-Saint-Michel\"", "\"Chichen Itza\"", "\"Forbidden City\"",
        "Acropolis Athens", "\"Hagia Sophia\"", "\"Petronas Towers\"", "\"Marina Bay\"", "\"Brooklyn Bridge\"",
